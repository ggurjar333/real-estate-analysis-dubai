# Environment configuration for Real Estate Analysis Dubai
# Copy this file to .env and update the values as needed

# Ejari rent transactions endpoint (secret — do not commit the real value)
EJARI_URL=your_ejari_endpoint_here

# GitHub Token for publishing releases (obtain from GitHub settings)
GH_TOKEN=your_github_token_here

# (Optional) Other API keys can be added below
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key
